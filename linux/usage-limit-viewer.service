[Unit]
Description=Usage Limit Viewer (reads AI usage limits for the taskbar)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/usage-limit-viewer/ulv.py daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
